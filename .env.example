# Juris Monorepo - Root Environment Configuration
# This file serves as a template for environment variables.
# Copy this to .env and configure for your environment.

# Each service has its own .env.example with service-specific configurations.
# See services/<service-name>/.env.example for individual service settings.

# Global Settings
NODE_ENV=development

# Database Connection (Shared across services - override per service if needed)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Configuration (Shared secret for inter-service communication)
JWT_SECRET=74db5010c1cd2989e21f49160e22e014b51625097bb721535c529de2cb97f58d
JWT_REFRESH_SECRET=59292b190434a15524d53f2e03df1a5f961d5852ee9ed42b9a4c5f8601b80a81

# Apache Pulsar (Event Bus)
PULSAR_SERVICE_URL=pulsar://localhost:6650

# Redis (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 Configuration (Shared) - Use MinIO for local development
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=ap-southeast-1

# Service Ports
CIAS_PORT=3001
HUB_PORT=3002
VAULT_PORT=3003
COMMS_PORT=3004
BILLING_PORT=3005
SIEM_PORT=3006
GUARD_PORT=3007

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
