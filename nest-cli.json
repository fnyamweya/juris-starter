{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "services/cias",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "services/cias/tsconfig.json"
  },
  "projects": {
    "cias": {
      "type": "application",
      "root": "services/cias",
      "entryFile": "main",
      "sourceRoot": "services/cias/src",
      "compilerOptions": {
        "tsConfigPath": "services/cias/tsconfig.json"
      }
    },
    "hub": {
      "type": "application",
      "root": "services/hub",
      "entryFile": "main",
      "sourceRoot": "services/hub/src",
      "compilerOptions": {
        "tsConfigPath": "services/hub/tsconfig.json"
      }
    },
    "vault": {
      "type": "application",
      "root": "services/vault",
      "entryFile": "main",
      "sourceRoot": "services/vault/src",
      "compilerOptions": {
        "tsConfigPath": "services/vault/tsconfig.json"
      }
    },
    "comms": {
      "type": "application",
      "root": "services/comms",
      "entryFile": "main",
      "sourceRoot": "services/comms/src",
      "compilerOptions": {
        "tsConfigPath": "services/comms/tsconfig.json"
      }
    },
    "billing": {
      "type": "application",
      "root": "services/billing",
      "entryFile": "main",
      "sourceRoot": "services/billing/src",
      "compilerOptions": {
        "tsConfigPath": "services/billing/tsconfig.json"
      }
    },
    "siem": {
      "type": "application",
      "root": "services/siem",
      "entryFile": "main",
      "sourceRoot": "services/siem/src",
      "compilerOptions": {
        "tsConfigPath": "services/siem/tsconfig.json"
      }
    },
    "guard": {
      "type": "application",
      "root": "services/guard",
      "entryFile": "main",
      "sourceRoot": "services/guard/src",
      "compilerOptions": {
        "tsConfigPath": "services/guard/tsconfig.json"
      }
    },
    "core": {
      "type": "library",
      "root": "packages/core",
      "entryFile": "index",
      "sourceRoot": "packages/core/src",
      "compilerOptions": {
        "tsConfigPath": "packages/core/tsconfig.json"
      }
    },
    "database": {
      "type": "library",
      "root": "packages/database",
      "entryFile": "index",
      "sourceRoot": "packages/database/src",
      "compilerOptions": {
        "tsConfigPath": "packages/database/tsconfig.json"
      }
    },
    "common": {
      "type": "library",
      "root": "packages/common",
      "entryFile": "index",
      "sourceRoot": "packages/common/src",
      "compilerOptions": {
        "tsConfigPath": "packages/common/tsconfig.json"
      }
    },
    "events": {
      "type": "library",
      "root": "packages/events",
      "entryFile": "index",
      "sourceRoot": "packages/events/src",
      "compilerOptions": {
        "tsConfigPath": "packages/events/tsconfig.json"
      }
    }
  }
}
