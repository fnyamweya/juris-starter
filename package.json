{
  "name": "juris",
  "version": "0.0.1",
  "description": "Juris Monorepo - Legal Practice Management Platform",
  "author": "Juris Team",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=packages/shared-core --workspace=packages/shared-database --workspace=packages/shared-common",
    "build:services": "npm run build --workspaces --if-present -- --scope='@juris/service-*'",
    "format": "prettier --write \"packages/**/*.ts\" \"apps/**/*.ts\" \"services/**/*.ts\"",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" \"services/**/*.ts\" --fix",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "start:cias": "npm run start:dev --workspace=services/cias",
    "start:hub": "npm run start:dev --workspace=services/hub",
    "start:repo": "npm run start:dev --workspace=services/repo",
    "start:comms": "npm run start:dev --workspace=services/comms",
    "start:billing": "npm run start:dev --workspace=services/billing",
    "start:siem": "npm run start:dev --workspace=services/siem",
    "start:guard": "npm run start:dev --workspace=services/guard"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  }
}
